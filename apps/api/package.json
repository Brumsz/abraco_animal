{
  "name": "@abraco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentacao.ts src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentacao.js dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "openapi:gerar": "tsx src/openapi/gerar.ts",
    "criar-admin": "tsx --env-file-if-exists=../../.env src/scripts/criar-admin.ts",
    "semear": "tsx --env-file-if-exists=../../.env src/scripts/semear.ts"
  },
  "dependencies": {
    "@abraco/shared": "workspace:*",
    "@aws-sdk/client-s3": "3.1167.0",
    "@aws-sdk/s3-request-presigner": "3.1167.0",
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@fastify/rate-limit": "~11.2.2",
    "@fastify/swagger": "9.9.3",
    "@fastify/websocket": "11.3.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.12.0",
    "argon2": "0.45.2",
    "bullmq": "~6.7.2",
    "fast-jwt": "6.3.6",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "nodemailer": "^10.4.0",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15"
  }
}
