# =====================================================================
#  Abraço Animal — variáveis de ambiente
#  Copie para .env e preencha. NUNCA commite o .env.
#  Valores marcados "gerar" devem ser criados com os comandos indicados.
#  Em produção: use o cofre de segredos da plataforma (Railway/AWS).
# =====================================================================

# ── API ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Origens permitidas no CORS (separadas por vírgula). O app nativo não usa
# CORS; isto vale para ferramentas web (Swagger UI, Expo web em dev).
CORS_ORIGINS=http://localhost:8081

# ── PostgreSQL 16 ────────────────────────────────────────────────────
POSTGRES_USER=abraco
# gerar: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=abraco
# Porta no host (5433 evita conflito com Postgres instalado localmente)
POSTGRES_PORTA_HOST=5433
# Usado pelo Prisma fora do Docker (o docker-compose sobrescreve o host para "postgres")
DATABASE_URL=postgresql://abraco:TROQUE_PELA_SENHA@localhost:5433/abraco?schema=public

# ── Redis 7 ──────────────────────────────────────────────────────────
# gerar: openssl rand -base64 24
REDIS_PASSWORD=
REDIS_URL=redis://:TROQUE_PELA_SENHA@localhost:6379

# ── JWT (EdDSA / Ed25519) ────────────────────────────────────────────
# gerar: openssl genpkey -algorithm ed25519 -out jwt.pem
#        openssl pkey -in jwt.pem -pubout -out jwt.pub.pem
# Cole o conteúdo PEM em base64 (uma linha): base64 -w0 jwt.pem
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ISSUER=https://api.abracoanimal.org.br
JWT_AUDIENCE=abraco-animal-app
ACCESS_TOKEN_TTL_SEGUNDOS=900
REFRESH_TOKEN_TTL_DIAS=30

# ── Criptografia de dados pessoais (LGPD) ────────────────────────────
# AES-256-GCM para CPF e data de nascimento — gerar: openssl rand -base64 32
DADOS_CRYPTO_KEY_B64=
# Versão da chave atual (para rotação sem perder dados antigos)
DADOS_CRYPTO_KEY_VERSAO=1
# HMAC-SHA256 do blind index de CPF — CHAVE DIFERENTE da anterior
# gerar: openssl rand -base64 32
CPF_HMAC_KEY_B64=

# ── Armazenamento de imagens (S3 compatível) ─────────────────────────
# Em dev: SeaweedFS do docker-compose. Em produção: AWS S3 ou Cloudflare R2.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=abraco-imagens
# gerar: openssl rand -hex 16  /  openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_URL_ASSINADA_TTL_SEGUNDOS=3600

# ── Pix / Asaas ──────────────────────────────────────────────────────
# Sandbox: https://api-sandbox.asaas.com/v3  ·  Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token configurado no painel do Asaas para autenticar o webhook
# gerar: openssl rand -base64 32
ASAAS_WEBHOOK_TOKEN=
PIX_EXPIRACAO_MINUTOS=15

# ── E-mail (Nodemailer) ──────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE="Abraço Animal <nao-responda@abracoanimal.org.br>"

# ── Notificações push (Expo) ─────────────────────────────────────────
# Token de acesso do Expo (Push Security habilitado) — https://expo.dev/settings/access-tokens
EXPO_ACCESS_TOKEN=

# ── Observabilidade ──────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=abraco-api

# ── App mobile (expostas no bundle — nunca coloque segredos aqui) ────
EXPO_PUBLIC_API_URL=http://localhost:3333/v1
